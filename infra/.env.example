# =============================================================
# DevHub — Environment Variable Matrix
# Copy this file to .env in the appropriate tier directory
# =============================================================

# ─── DATABASE (Neon PostgreSQL) ───────────────────────────────
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/devhub?sslmode=require

# ─── SPRING SECURITY / JWT ────────────────────────────────────
JWT_SECRET=your-256-bit-hex-secret-here
JWT_ACCESS_EXPIRY_MS=900000        # 15 minutes
JWT_REFRESH_EXPIRY_MS=604800000    # 7 days

# ─── GITHUB OAUTH2 ────────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_REDIRECT_URI=http://localhost:8080/login/oauth2/code/github

# ─── GEMINI (Phase 3 — AI features) ───────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest

# ─── SUPABASE STORAGE ─────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=devhub-uploads

# ─── REDIS (Optional, Phase 3+) ───────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── SERVER ───────────────────────────────────────────────────
SERVER_PORT=8080
ALLOWED_ORIGINS=http://localhost:5173

# ─── FRONTEND (Vite — prefix VITE_ for browser exposure) ──────
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_NAME=DevHub
