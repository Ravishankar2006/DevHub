# =============================================================
# DevHub — environment variables
#
# Backend:  copy to backend/.env   (run-backend.sh loads it automatically)
# Frontend: copy the VITE_ block to frontend/.env.local
#
# This file lists every variable the code actually reads. Where a default
# is noted, that is what the app falls back to when the variable is unset,
# so only the two REQUIRED ones are needed to boot locally.
#
# Comments stay on their own lines: run-backend.sh exports this file with
# `export $(grep -v '^#' .env | xargs)`, which does not strip trailing
# comments off a value.
# =============================================================


# ─── REQUIRED ────────────────────────────────────────────────

# PostgreSQL connection. Accepts either a postgresql:// URI (what Neon and
# most PaaS providers hand you) or a jdbc:postgresql:// URL — DatabaseConfig
# parses the credentials out of the URI form.
#   Neon:          postgresql://user:password@ep-xxx.region.aws.neon.tech/devhub?sslmode=require
#   Local compose: postgresql://devhub:devhub_local_secret@localhost:5432/devhub
# Not needed when running the dev profile, which uses in-memory H2.
NEON_DATABASE_URL=postgresql://devhub:devhub_local_secret@localhost:5432/devhub

# HMAC-SHA256 signing key. Decoded as Base64 first, falling back to raw UTF-8
# bytes; must yield at least 32 bytes or the app refuses to start.
#   Generate: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-generated-256-bit-secret


# ─── JWT LIFETIMES ───────────────────────────────────────────

# default: 900000 (15 minutes)
JWT_ACCESS_EXPIRY_MS=900000

# default: 604800000 (7 days)
JWT_REFRESH_EXPIRY_MS=604800000


# ─── AI (Gemini) ─────────────────────────────────────────────
# Unset: the app boots fine, but AI chat, the agent, resume review,
# the daily brief and semantic search all fail at call time.
# Key: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# default: gemini-flash-latest
GEMINI_MODEL=gemini-flash-latest

# default: gemini-embedding-001
GEMINI_EMBEDDING_MODEL=gemini-embedding-001


# ─── GITHUB OAUTH ────────────────────────────────────────────
# Unset: every other module works, GitHub integration doesn't.
# Create an OAuth app: https://github.com/settings/developers
# The callback URL registered there must match GITHUB_REDIRECT_URI exactly.

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# default: http://localhost:8080/api/github/callback
GITHUB_REDIRECT_URI=http://localhost:8080/api/github/callback


# ─── SERVER & CORS ───────────────────────────────────────────

# Port. Render and most PaaS providers inject PORT; SERVER_PORT is the local
# override. Resolution order: PORT -> SERVER_PORT -> 8080.
SERVER_PORT=8080

# CORS allowlist — comma-separated origins, no wildcard.
# default: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Where the backend redirects back to after the GitHub OAuth round trip.
# default: http://localhost:5173
FRONTEND_URL=http://localhost:5173


# ─── FRONTEND (frontend/.env.local) ──────────────────────────
# Vite only exposes variables prefixed VITE_ to the browser.
# Never put a secret here — it ships in the bundle.

# default: http://localhost:8080/api
VITE_API_BASE_URL=http://localhost:8080/api
