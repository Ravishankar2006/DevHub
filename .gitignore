# ===========================
# DevHub — Root .gitignore
# ===========================

# ─── Environment files ───
.env
.env.local
.env.*.local
*.env

# ─── Frontend (Node / Vite) ───
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.cache/

# ─── Backend (Maven / Spring Boot) ───
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*

# ─── IDE ───
.idea/
*.iml
.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ─── Logs ───
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS ───
.DS_Store
.directory
